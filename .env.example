# ============ 安全 ============
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============ 数据库 ============
# 开发（SQLite，零配置）：
DATABASE_URL=sqlite+aiosqlite:///./supplier.db

# 生产（PostgreSQL，docker compose）：
# DATABASE_URL=postgresql+asyncpg://risk_user:risk_pass@db:5432/risk_db